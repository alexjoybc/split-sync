{
  "expo": {
    "name": "SplitSync Stopwatch",
    "slug": "splitsync-stopwatch",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "org.splitsync.stopwatch",
    "userInterfaceStyle": "light",
    "android": {
      "package": "org.splitsync.stopwatch",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F0E8"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "splitsync.org",
              "pathPrefix": "/stopwatch/s/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "EXPO_PUBLIC_SUPABASE_URL": "https://bsihlrzncucrglqltjrc.supabase.co"
    },
    "platforms": ["android"],
    "plugins": ["expo-font"]
  }
}
