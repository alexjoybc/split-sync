              "scheme": "https",
              "host": "splitsync.org",
              "pathPrefix": "/stopwatch/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "EXPO_PUBLIC_SUPABASE_URL": "https://bsihlrzncucrglqltjrc.supabase.co",
      "eas": {
        "projectId": "3617f3ce-e97b-497f-90fe-af489ea86aac"
      }
    },
    "platforms": ["android"],
    "plugins": ["expo-font", "expo-audio", "./plugins/withStoragePermissions"]
  }
}
