{
  "expo": {
    "name": "SplitSync Stopwatch",
    "slug": "splitsync-stopwatch",
    "owner": "split-sync",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "org.splitsync.stopwatch",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3617f3ce-e97b-497f-90fe-af489ea86aac"
    },
    "android": {
      "package": "org.splitsync.stopwatch",
      "allowBackup": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "splitsync.org",
              "pathPrefix": "/stopwatch/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "EXPO_PUBLIC_SUPABASE_URL": "https://bsihlrzncucrglqltjrc.supabase.co",
      "eas": {
        "projectId": "3617f3ce-e97b-497f-90fe-af489ea86aac"
      }
    },
    "platforms": [
      "android"
    ],
    "plugins": [
      "expo-font",
      "expo-audio",
      "./plugins/withStoragePermissions",
      "./plugins/withStripRecordAudio",
      "expo-web-browser",
      "./plugins/withRemoveSystemAlertWindow",
      "./plugins/withGradleJvmMemory",
      "./plugins/withProguardCleanup",
      "./plugins/withReleaseR8Optimization"
    ]
  }
}
