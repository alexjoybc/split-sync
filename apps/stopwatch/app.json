{
  "expo": {
    "name": "SplitSync Stopwatch",
    "slug": "splitsync-stopwatch",
    "owner": "split-sync",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "org.splitsync.stopwatch",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3617f3ce-e97b-497f-90fe-af489ea86aac"
    },
    "android": {
      "package": "org.splitsync.stopwatch",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F0E8"
