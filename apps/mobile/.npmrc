# Expo and React Native rely on transitive peer dependencies being resolvable
# from within the pnpm virtual store. Without hoisting, commands like
# expo/bin/autolinking (which requires expo-modules-autolinking as a peer dep)
# fail with MODULE_NOT_FOUND when run by the Expo Autolinking Gradle plugin.
#
# public-hoist-pattern[]=* hoists all packages to the workspace root's
# node_modules, giving them the same flat resolution that npm/yarn provide.
# This is the recommended fix for Expo + pnpm.
# See: https://docs.expo.dev/guides/monorepos/#create-our-first-app
public-hoist-pattern[]=*
